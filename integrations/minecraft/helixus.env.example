# Helixus live mode. Copy this file to .env.local (git-ignored) and adjust; .env.local overrides .env.
# See README.helixus.md.

# Planner LLM: the local llama-server started by E:\aivup\start_mc_llm.bat (OpenAI-compatible, keep the trailing slash)
OPENAI_API_BASEURL=http://127.0.0.1:8081/v1/
OPENAI_API_KEY=local
OPENAI_MODEL=qwen3.6
OPENAI_REASONING_MODEL=qwen3.6

# Minecraft server. BOT_VERSION=auto asks the server for its version.
# BOT_AUTH=offline needs a server with online-mode=false (a vanilla LAN world is online-mode and rejects the bot).
BOT_USERNAME=Helixus
BOT_HOSTNAME=127.0.0.1
BOT_PORT=25565
BOT_VERSION=auto
BOT_AUTH=offline
# Your own in-game name: the bot treats this player as its master (e.g. does not fight back when you hit it)
BOT_MASTER_USERNAME=

# Local HTTP link for the AITuberKit page (Ctrl+Alt+M). Loopback only.
HELIXUS_LINK_PORT=8098
HELIXUS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Planner history window: cut back to KEEP messages once it passes MAX, so the local model can reuse its prompt cache
BRAIN_HISTORY_MAX=60
BRAIN_HISTORY_KEEP=40
